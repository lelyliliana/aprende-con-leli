if(NOT DEFINED WORK OR NOT DEFINED SOURCE OR NOT DEFINED EXE)
  message(FATAL_ERROR "Faltan rutas de comprobación")
endif()
# WORK es una carpeta propia del build asignada por CMakeLists.txt.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(COPY "${SOURCE}/datos" DESTINATION "${WORK}")
set(opciones)
if(NOT INPUT STREQUAL "")
  list(APPEND opciones INPUT_FILE "${INPUT}")
endif()
execute_process(COMMAND "${EXE}" WORKING_DIRECTORY "${WORK}" ${opciones}
  RESULT_VARIABLE estado OUTPUT_VARIABLE actual ERROR_VARIABLE errores TIMEOUT 15)
if(NOT "${estado}" STREQUAL "${STATUS}")
  message(FATAL_ERROR "Estado ${estado}; esperado ${STATUS}. ${errores}")
endif()
file(READ "${EXPECTED}" esperado)
foreach(variable actual esperado)
  string(REPLACE "\r\n" "\n" ${variable} "${${variable}}")
  string(REGEX REPLACE "[ \t]+\n" "\n" ${variable} "${${variable}}")
endforeach()
if(NOT actual STREQUAL esperado)
  message(FATAL_ERROR "Salida distinta.\nEsperada:\n${esperado}\nObservada:\n${actual}")
endif()
if(NOT errores STREQUAL ERROR_EXPECTED)
  message(FATAL_ERROR "stderr inesperado: ${errores}")
endif()
message(STATUS "Salida comprobada:\n${actual}")
