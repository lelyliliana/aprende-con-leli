file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
file(COPY "${SOURCE}/datos" DESTINATION "${WORK}")
if(MODO STREQUAL "valida")
  execute_process(COMMAND "${EXE}" datos/inventario.csv salidas/reporte.csv WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE estado OUTPUT_VARIABLE salida ERROR_VARIABLE errores)
  if(NOT estado EQUAL 0 OR NOT errores STREQUAL "")
    message(FATAL_ERROR "La entrada válida falló: ${errores}")
  endif()
  file(READ "${WORK}/salidas/reporte.csv" reporte)
  string(REPLACE "\r\n" "\n" reporte "${reporte}")
  file(READ "${SOURCE}/proyecto/muestra/reporte.csv" esperado)
  if(NOT reporte STREQUAL esperado)
    message(FATAL_ERROR "Reporte incorrecto")
  endif()
  file(SHA256 "${WORK}/datos/inventario.csv" despues)
  file(SHA256 "${SOURCE}/datos/inventario.csv" antes)
  if(NOT antes STREQUAL despues)
    message(FATAL_ERROR "Se modificó el origen")
  endif()
  # Repetir sobre la salida existente debe rechazar, no sobrescribir.
  execute_process(COMMAND "${EXE}" datos/inventario.csv salidas/reporte.csv WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE segundo OUTPUT_QUIET ERROR_QUIET)
  if(NOT segundo EQUAL 2)
    message(FATAL_ERROR "No se rechazó salida existente")
  endif()
  file(READ "${WORK}/salidas/reporte.csv" conservado)
  string(REPLACE "\r\n" "\n" conservado "${conservado}")
  if(NOT conservado STREQUAL esperado)
    message(FATAL_ERROR "La repetición alteró la salida")
  endif()
elseif(MODO STREQUAL "invalida")
  execute_process(COMMAND "${EXE}" datos/invalido.csv rechazada/reporte.csv WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE estado OUTPUT_VARIABLE salida ERROR_VARIABLE errores)
  if(NOT estado EQUAL 2 OR EXISTS "${WORK}/rechazada")
    message(FATAL_ERROR "No se rechazó antes de crear resultados")
  endif()
elseif(MODO STREQUAL "misma_ruta")
  file(SHA256 "${WORK}/datos/inventario.csv" antes)
  execute_process(COMMAND "${EXE}" datos/inventario.csv datos/inventario.csv WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE estado OUTPUT_QUIET ERROR_QUIET)
  file(SHA256 "${WORK}/datos/inventario.csv" despues)
  if(NOT estado EQUAL 2 OR NOT antes STREQUAL despues)
    message(FATAL_ERROR "No se protegió la entrada")
  endif()
else()
  execute_process(COMMAND "${EXE}" WORKING_DIRECTORY "${WORK}" RESULT_VARIABLE estado OUTPUT_QUIET ERROR_VARIABLE errores)
  if(NOT estado EQUAL 2 OR NOT errores MATCHES "Uso: inventario")
    message(FATAL_ERROR "Uso incorrecto sin diagnóstico")
  endif()
endif()
message(STATUS "CLI ${MODO}: correcto")
