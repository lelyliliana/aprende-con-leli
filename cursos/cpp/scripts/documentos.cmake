file(GLOB_RECURSE documentos "${ROOT}/*.md")
set(cantidad 0)
foreach(archivo IN LISTS documentos)
  if(archivo MATCHES "/build[^/]*/" OR archivo MATCHES "/salidas/")
    continue()
  endif()
  file(READ "${archivo}" texto)
  if(texto MATCHES "�|contentReference|oaicite")
    message(FATAL_ERROR "Marca interna o carácter dañado: ${archivo}")
  endif()
  string(REGEX MATCHALL "```" cierres "${texto}")
  list(LENGTH cierres n)
  math(EXPR resto "${n}%2")
  if(NOT resto EQUAL 0)
    message(FATAL_ERROR "Bloque sin cerrar: ${archivo}")
  endif()
  string(REGEX REPLACE "```[^`]*```" "" texto "${texto}")
  string(REGEX REPLACE "`[^`]*`" "" texto "${texto}")
  string(REGEX MATCHALL "\\]\\([^)]+\\)" enlaces "${texto}")
  string(REPLACE "](" "" enlaces "${enlaces}")
  get_filename_component(carpeta "${archivo}" DIRECTORY)
  foreach(enlace IN LISTS enlaces)
    string(REGEX REPLACE "\\)$" "" destino "${enlace}")
    if(destino MATCHES "^[A-Za-z]+:" OR destino MATCHES "^#")
      continue()
    endif()
    string(REGEX REPLACE "#.*$" "" destino "${destino}")
    if(NOT EXISTS "${carpeta}/${destino}")
      message(FATAL_ERROR "Enlace roto: ${archivo} -> ${destino}")
    endif()
    math(EXPR cantidad "${cantidad}+1")
  endforeach()
endforeach()
message(STATUS "Enlaces locales comprobados: ${cantidad}")
